{
  "name": "meridyen-haber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --use-env-proxy --env-file-if-exists=.env scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "build:launch": "node --use-env-proxy --env-file-if-exists=.env scripts/build.mjs --launch",
    "build:vercel": "node --use-env-proxy --env-file-if-exists=.env scripts/build-vercel.mjs",
    "assets": "node scripts/assets.mjs",
    "preview": "node scripts/preview.mjs",
    "dev": "npm run build:demo && npm run preview",
    "ingest": "node --use-env-proxy --env-file-if-exists=.env scripts/ingest.mjs",
    "verify": "node --use-env-proxy --env-file-if-exists=.env scripts/verify.mjs",
    "social": "node --use-env-proxy --env-file-if-exists=.env scripts/social.mjs",
    "preflight": "node --use-env-proxy --env-file-if-exists=.env scripts/preflight.mjs",
    "sources:import": "node --use-env-proxy --env-file-if-exists=.env scripts/import-sources.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "eval": "node scripts/eval/run.mjs",
    "eval:live": "node --use-env-proxy --env-file-if-exists=.env scripts/eval/run.mjs --live",
    "audit:site": "node scripts/audit.mjs",
    "test:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "fast-xml-parser": "5.11.2",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0",
    "opentype.js": "1.3.4",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
